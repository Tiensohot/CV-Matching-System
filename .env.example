# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cv_matching
POSTGRES_DB=cv_matching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Optional LLM providers
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin account (tạo lần đầu khi khởi động)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Email (dùng cho tính năng gửi email ứng tuyển)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password        # Gmail App Password (không phải mật khẩu thường)
MAIL_FROM=your-email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=CV Matching System
